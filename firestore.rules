rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- HELPERS ----

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Vérifie qu'un ami a le statut "accepté" dans la sous-collection de l'utilisateur cible
    function isFriendOf(uid) {
      return isAuth()
        && exists(/databases/$(database)/documents/utilisateurs/$(uid)/amis/$(request.auth.uid))
        && get(/databases/$(database)/documents/utilisateurs/$(uid)/amis/$(request.auth.uid)).data.statut == "accepté";
    }

    function compteurMemos(uid) {
      let d = get(/databases/$(database)/documents/utilisateurs/$(uid)).data;
      return ('compteurMemos' in d) ? d.compteurMemos : 0;
    }

    function compteurCustom(uid) {
      let d = get(/databases/$(database)/documents/utilisateurs/$(uid)).data;
      return ('compteurCustom' in d) ? d.compteurCustom : 0;
    }

    // ---- PSEUDOS ----
    // Collection globale pour garantir l'unicité des pseudos.
    // Lecture ouverte aux connectés (vérification de dispo), écriture réservée au propriétaire.
    match /pseudos/{pseudo} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ---- UTILISATEURS ----
    match /utilisateurs/{uid} {
      // Profil : lisible par l'utilisateur lui-même et ses amis acceptés
      allow read:   if isOwner(uid) || isFriendOf(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;

      // Inventaire : lisible par les amis (pour la page collection d'un ami)
      match /inventaire/{figurineId} {
        allow read:  if isOwner(uid) || isFriendOf(uid);
        allow write: if isOwner(uid);
      }

      // Mémos : strictement privés + limite 100
      match /memos/{memoId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid) && compteurMemos(uid) < 100;
        allow update: if isOwner(uid);
        allow delete: if isOwner(uid);
      }

      // Figurines custom : lisibles par les amis + limite 200
      match /figurinesCustom/{customId} {
        allow read:   if isOwner(uid) || isFriendOf(uid);
        allow create: if isOwner(uid) && compteurCustom(uid) < 200;
        allow update: if isOwner(uid);
        allow delete: if isOwner(uid);
      }

      // Amis : les deux parties d'une relation peuvent écrire leur entrée respective
      // (envoi de demande, acceptation, suppression)
      match /amis/{amiUid} {
        allow read:  if isOwner(uid);
        allow write: if isAuth()
          && (request.auth.uid == uid || request.auth.uid == amiUid);
      }
    }
  }
}
