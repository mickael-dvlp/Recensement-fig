rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- HELPERS ----

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Vérifie qu'un ami a le statut "accepté" dans la sous-collection de l'utilisateur cible
    function isFriendOf(uid) {
      return isAuth()
        && exists(/databases/$(database)/documents/utilisateurs/$(uid)/amis/$(request.auth.uid))
        && get(/databases/$(database)/documents/utilisateurs/$(uid)/amis/$(request.auth.uid)).data.statut == "accepté";
    }

    function compteurMemos(uid) {
      let d = get(/databases/$(database)/documents/utilisateurs/$(uid)).data;
      return ('compteurMemos' in d) ? d.compteurMemos : 0;
    }

    function compteurCustom(uid) {
      let d = get(/databases/$(database)/documents/utilisateurs/$(uid)).data;
      return ('compteurCustom' in d) ? d.compteurCustom : 0;
    }

    // Un document inventaire n'est jamais écrit intégralement (updateDoc envoie
    // seulement les champs modifiés) : chaque champ n'est donc validé que s'il est présent.
    function inventaireValide(d) {
      return d.keys().hasOnly(["figurineId", "enInventaire", "quantiteInventaire", "souhaite", "quantiteSouhaitee", "enProjet", "quantitePeinte"])
        && (!('figurineId' in d) || d.figurineId is string)
        && (!('enInventaire' in d) || d.enInventaire is bool)
        && (!('quantiteInventaire' in d) || (d.quantiteInventaire is int && d.quantiteInventaire >= 0 && d.quantiteInventaire <= 9999))
        && (!('souhaite' in d) || d.souhaite is bool)
        && (!('quantiteSouhaitee' in d) || (d.quantiteSouhaitee is int && d.quantiteSouhaitee >= 0 && d.quantiteSouhaitee <= 9999))
        && (!('enProjet' in d) || d.enProjet is bool)
        && (!('quantitePeinte' in d) || (d.quantitePeinte is int && d.quantitePeinte >= 0 && d.quantitePeinte <= 9999));
    }

    // Champs autorisés pour un document de la sous-collection amis (2 côtés de la relation).
    function amiValide(d) {
      return d.keys().hasOnly(["statut", "pseudo"])
        && d.pseudo is string && d.pseudo.size() <= 30;
    }

    // Pseudo valide : 3–30 caractères, lettres/chiffres/tirets/underscores uniquement.
    function pseudoValide(p) {
      return p is string && p.size() >= 3 && p.size() <= 30 && p.matches('[a-zA-Z0-9_\\-]+');
    }

    // Cooldown 7 jours entre deux changements de pseudo.
    // Retourne true si le profil n'existe pas encore (1ère réservation, à l'inscription),
    // n'a jamais changé de pseudo, ou si 7 jours sont écoulés. Le check d'existence est
    // impératif : get(...).data sur un profil inexistant fait échouer l'évaluation de la
    // règle (donc refuse la création du pseudo) — ce qui cassait l'inscription email/mdp,
    // où le pseudo est réservé avant que le profil ne soit créé.
    function pseudoCooldownPasse(uid) {
      return !exists(/databases/$(database)/documents/utilisateurs/$(uid))
        || !('dernierChangementPseudo' in get(/databases/$(database)/documents/utilisateurs/$(uid)).data)
        || (request.time.toMillis() - get(/databases/$(database)/documents/utilisateurs/$(uid)).data.dernierChangementPseudo.toMillis()) > 604800000;
    }

    // ---- PSEUDOS ----
    // Collection globale pour garantir l'unicité des pseudos.
    // "get" public (pas "list") : la vérification de dispo à l'inscription se fait
    // AVANT que le compte existe, donc sans authentification — mais rien n'autorise
    // à énumérer tous les pseudos réservés (list refusé, seule une lecture ciblée
    // d'un pseudo déjà connu est possible). Écriture réservée au propriétaire.
    match /pseudos/{pseudo} {
      allow get: if true;
      allow list: if false;
      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && pseudoValide(pseudo)
        && request.resource.data.keys().hasOnly(["uid", "pseudo"])
        && request.resource.data.pseudo is string
        && request.resource.data.pseudo.size() <= 30
        && pseudoCooldownPasse(request.auth.uid);
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ---- UTILISATEURS ----
    match /utilisateurs/{uid} {
      // Profil : lisible par l'utilisateur lui-même et ses amis acceptés
      allow read:   if isOwner(uid) || isFriendOf(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;

      // Inventaire : lisible par les amis (pour la page collection d'un ami)
      match /inventaire/{figurineId} {
        allow read:   if isOwner(uid) || isFriendOf(uid);
        allow create: if isOwner(uid) && inventaireValide(request.resource.data);
        allow update: if isOwner(uid) && inventaireValide(request.resource.data);
        allow delete: if isOwner(uid);
      }

      // Mémos : strictement privés + limite 100 + validation taille des champs
      match /memos/{memoId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid)
          && compteurMemos(uid) < 100
          && request.resource.data.titre is string
          && request.resource.data.titre.size() <= 200
          && request.resource.data.texte is string
          && request.resource.data.texte.size() <= 50000;
        allow update: if isOwner(uid)
          && (!('titre' in request.resource.data) || (request.resource.data.titre is string && request.resource.data.titre.size() <= 200))
          && (!('texte' in request.resource.data) || (request.resource.data.texte is string && request.resource.data.texte.size() <= 50000));
        allow delete: if isOwner(uid);
      }

      // Figurines custom : lisibles par les amis + limite 200
      match /figurinesCustom/{customId} {
        allow read:   if isOwner(uid) || isFriendOf(uid);
        allow create: if isOwner(uid) && compteurCustom(uid) < 200;
        allow update: if isOwner(uid);
        allow delete: if isOwner(uid);
      }

      // Amis : règles granulaires pour éviter l'auto-injection d'amitié.
      // Protocole à 2 états : expéditeur → "envoyé", destinataire → "reçu", puis "accepté" des deux côtés.
      match /amis/{amiUid} {
        allow read: if isOwner(uid);

        // Propriétaire envoie une demande (crée son propre côté "envoyé")
        allow create: if isOwner(uid)
          && request.resource.data.statut == "envoyé"
          && amiValide(request.resource.data);

        // Propriétaire accepte une demande reçue ("reçu" → "accepté")
        allow update: if isOwner(uid)
          && resource.data.statut == "reçu"
          && request.resource.data.statut == "accepté"
          && amiValide(request.resource.data);

        // Propriétaire supprime (annulation envoi, refus d'une demande, suppression d'ami)
        allow delete: if isOwner(uid);

        // L'ami (amiUid) place la notification "reçu" dans la sous-collection du propriétaire
        allow create: if request.auth.uid == amiUid
          && request.resource.data.statut == "reçu"
          && amiValide(request.resource.data);

        // L'ami (amiUid) confirme la demande côté expéditeur ("envoyé" → "accepté")
        allow update: if request.auth.uid == amiUid
          && resource.data.statut == "envoyé"
          && request.resource.data.statut == "accepté"
          && amiValide(request.resource.data);

        // L'ami (amiUid) peut supprimer (retrait d'amitié ou refus)
        allow delete: if request.auth.uid == amiUid;
      }
    }
  }
}
